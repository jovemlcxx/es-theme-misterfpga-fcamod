<theme>
   <formatVersion>7</formatVersion>
   <!-- 4:3 (640x480), laid out in pixels and written as fractions of the screen (/640, /480). The original is a small window centred on the screen: here it
        is as large as the screen allows, keeping its proportions (header, 40 px side column, list), with the 23 px margin of the other themes around the rest.
          battery + clock  centre line y 43, right edge x 584 (the window's); laid out for the widest clock text (12 h, "11:33 AM" ~90 px): the battery (icon + %, ~62 px, ~70 px at "100%") ends at least 20 px before it
          header           x 56..584, y 68..108
          side column      x 56..96,  y 132..396 (the rotated name of the screen)
          list             x 96..584, y 132..396: 11 rows of 24 px (a 16 px font, line spacing 1.5); the selected row is the 6th (y 252..276)
          button legend    y 0.895 (footer-enabled.xml) -->
   <view name="screen">
      <batteryIndicator name="batteryIndicator">
         <pos>0.6344 0.0659</pos>
         <size>0.1 0.06</size>
      </batteryIndicator>
      <text name="clock">
         <pos>0.7225 0.0596</pos>
         <size>0.19 0.06</size>
         <fontSize>0.03</fontSize>
         <alignment>right</alignment>
      </text>
   </view>
   <view name="system, basic, detailed, video, grid">
      <helpsystem name="help">
         <pos>0.04 0.93</pos>
         <fontSize>0.027</fontSize>
      </helpsystem>
      <image name="e_header" extra="true">
         <pos>0.0875 0.1417</pos>
         <size>0.825 0.0833</size>
      </image>
      <image name="e_side" extra="true">
         <pos>0.0875 0.275</pos>
         <size>0.0625 0.55</size>
      </image>
      <text name="e_title" extra="true">
         <pos>0.1 0.1417</pos>
         <size>0.52 0.0833</size>
         <fontSize>0.0292</fontSize>
      </text>
      <text name="e_side_label" extra="true">
         <pos>0.11875 0.55</pos>
         <size>0.4125 0.0833</size>
         <fontSize>0.0375</fontSize>
      </text>
   </view>

   <view name="system">
      <carousel name="systemcarousel">
         <pos>0.15 0.275</pos>
         <size>0.7625 0.55</size>
         <logoSize>0.7625 0.05</logoSize>
         <logoPos>0.0125 -1</logoPos>
         <maxLogoCount>11</maxLogoCount>
      </carousel>
      <text name="logoText">
         <fontSize>0.0265</fontSize>
      </text>
      <image name="e_bar" extra="true">
         <pos>0.15 0.525</pos>
         <size>0.7625 0.05</size>
      </image>
      <text name="e_bar_text" extra="true">
         <pos>0.1625 0.525</pos>
         <size>0.74 0.05</size>
         <fontSize>0.0265</fontSize>
      </text>
      <text name="systemInfo">
         <pos>0.5 0.1417</pos>
         <size>0.4 0.0833</size>
         <fontSize>0.0208</fontSize>
      </text>
   </view>

   <view name="basic, detailed, video, grid">
      <text name="e_title" extra="true">
         <size>0.8 0.0833</size>
      </text>
      <image name="e_panel" extra="true">
         <pos>0.15 0.275</pos>
         <size>0.7625 0.55</size>
      </image>
      <textlist name="gamelist">
         <pos>0.15 0.275</pos>
         <size>0.7625 0.55</size>
         <fontSize>0.0265</fontSize>
         <horizontalMargin>0.0125</horizontalMargin>
      </textlist>
   </view>
</theme>
